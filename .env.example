# Google AI Studio кілті. Ешқашан репозиторийге салмаңыз.
GEMINI_API_KEY=

# Міндетті емес баптаулар
# DEMO_MODE=0
# SEED_DEMO=1
# MAX_UPLOAD_MB=20
# MAX_PHOTOS=12
# MAX_PARALLEL_JOBS=2
# DATA_DIR=./data
# MODELS_EXTRACT=gemini-3.5-flash,gemini-3.8-flash,gemini-3.1-flash-lite
# MODELS_OCR=gemini-3.5-flash,gemini-3.8-flash,gemini-3.1-flash-lite
# MODELS_JUDGE=gemini-pro-latest,gemini-3.8-flash,gemini-3.5-flash,gemini-flash-latest

# ЖИ баптауларын интерфейстен өзгертуге рұқсат беретін токен. Орнатылмаса, баптау беті тек қарау режимінде.
# Ұзын кездейсоқ жол қолданыңыз, мысалы: python -c "import secrets;print(secrets.token_urlsafe(32))"
# ADMIN_TOKEN=

# Шектеу: бір IP-ден RATE_WINDOW_S секундта ең көбі осынша сұрау
# RATE_WINDOW_S=600
# RATE_SUBMIT=12
# RATE_ASSIGN=6
# RATE_AI_TEST=10
# Сервер алдындағы прокси саны (Render/HF = 1): клиент IP X-Forwarded-For-тан осы қадаммен алынады
# TRUST_PROXY_HOPS=1
